{
  "name": "solar-farm",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:security": "node --experimental-strip-types --test tests/security.test.mts tests/owner-bootstrap.test.mts",
    "verify:browser-secrets": "node scripts/verify-browser-secrets.mjs",
    "bootstrap:first-owner": "node --env-file-if-exists=.env.local scripts/bootstrap-first-owner.mjs",
    "verify:first-owner": "node --env-file-if-exists=.env.local scripts/bootstrap-first-owner.mjs --verify-only",
    "verify:remote-environment": "node --env-file-if-exists=.env.local scripts/verify-remote-environment.mjs",
    "test:property": "node --experimental-strip-types --test tests/property-acquisition.test.mts",
    "test:enrichment": "node --experimental-strip-types --test tests/property-enrichment.test.mts",
    "test:marketing": "node --experimental-strip-types --test tests/marketing-readiness.test.mts",
    "test:project": "node --experimental-strip-types --test tests/project-command-center.test.mts",
    "test:finance": "node --experimental-strip-types --test tests/financial-readiness.test.mts",
    "test:funding": "node --experimental-strip-types --test tests/funding-reap.test.mts",
    "test": "npm run test:security && npm run test:property && npm run test:enrichment && npm run test:marketing && npm run test:project && npm run test:finance && npm run test:funding && npm run verify:browser-secrets"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
