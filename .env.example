# Supabase authentication, database, and private storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URLs and optional map style. The app builds safely without map credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAP_STYLE_URL=

# Preliminary property screening. Census geocoding requires no credential;
# unsupported provider categories remain explicitly unavailable.
GEOCODING_PROVIDER=census
SCREENING_BATCH_MAX=10

# Optional contact delivery. Without these values, public marketing submissions validate and log locally.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
