# Supabase authentication, database, and private storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secure operations only. These are consumed by the first-owner CLI, never by browser code.
NSOUL_INITIAL_OWNER_USER_ID=
NSOUL_INITIAL_ORGANIZATION_NAME=NSoul LLC

# Public URLs and optional map style. The app builds safely without map credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAP_STYLE_URL=
LEGAL_CONTACT_EMAIL=legal@nsoul.co

# Preliminary property screening. Census, FEMA NFHL, USFWS NWI, and USGS EPQS
# are public services and require no credential. NLR solar resource is server-only.
GEOCODING_PROVIDER=census
SECONDARY_GEOCODING_PROVIDER=
SECONDARY_GEOCODING_API_KEY=
SOLAR_RESOURCE_API_KEY=
PARCEL_PROVIDER=
SCREENING_BATCH_MAX=10

# Optional contact delivery. Without these values, public marketing submissions validate and log locally.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
